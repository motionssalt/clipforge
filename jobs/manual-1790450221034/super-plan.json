        "segments": [
          {
            "start_seconds": 1141,
            "end_seconds": 1156,
            "voiceover_text": "Rentaro hits the wall and folds over it. His palm flattens against the stone and the sound tears straight out of his chest.",
            "keywords": [
              "rentaro",
              "collapse",
              "wall"
            ]
          },
          {
            "start_seconds": 1156,
            "end_seconds": 1180,
            "voiceover_text": "Memories wash in white behind him. A child's hand inside his. A kiss. A photograph with every single one of them together.",
            "keywords": [
              "memories",
              "flashback",
              "photograph"
            ]
          },
          {
            "start_seconds": 1188,
            "end_seconds": 1232,
            "voiceover_text": "By nightfall he is upright again and saying it out loud. The others look up at him, and not one of them argues.",
            "keywords": [
              "night",
              "resolve",
              "girlfriends"
            ]
          },
          {
            "start_seconds": 1232,
            "end_seconds": 1258,
            "voiceover_text": "They gather under a single lamp in an empty playground, standing close, waiting for him to finish the sentence he just started.",
            "keywords": [
              "park",
              "lamp",
              "gathering"
            ]
          }
        ]
      },
