        "segments": [
          {
            "start_seconds": 253,
            "end_seconds": 294,
            "voiceover_text": "A contest is announced in front of the whole crowd, and the rules are barely rules. The winner gets to stand beside Rentaro.",
            "keywords": [
              "contest",
              "announcement",
              "crowd"
            ]
          },
          {
            "start_seconds": 342,
            "end_seconds": 383,
            "voiceover_text": "One woman steps out in purple, arms bare, braid swinging, grinning far too wide. She did not come here to play anything gentle.",
            "keywords": [
              "challenger",
              "purple",
              "grin"
            ]
          },
          {
            "start_seconds": 387,
            "end_seconds": 421,
            "voiceover_text": "She lifts a grown man off the grass and throws him. He spirals up past the clouds until only his red coat is left.",
            "keywords": [
              "throw",
              "sky",
              "power"
            ]
          },
          {
            "start_seconds": 425,
            "end_seconds": 456,
            "voiceover_text": "A girlfriend catches that grip and holds it. Hands lock, knuckles whiten, and neither one gives a single inch on the open field.",
            "keywords": [
              "grapple",
              "standoff",
              "hands"
            ]
          }
        ]
      },
      {
