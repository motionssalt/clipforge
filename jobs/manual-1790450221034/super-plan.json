        "segments": [
          {
            "start_seconds": 516,
            "end_seconds": 550,
            "voiceover_text": "The whole competition dissolves into nonsense around him. Rentaro stares dead ahead, sweating quietly, and decides the safest move is saying nothing.",
            "keywords": [
              "chaos",
              "rentaro",
              "deadpan"
            ]
          },
          {
            "start_seconds": 562,
            "end_seconds": 601,
            "voiceover_text": "Then one voice cuts clean through it. Hakari steps forward with her fists at her chest, and every head in the crowd turns.",
            "keywords": [
              "hakari",
              "speaking up",
              "crowd"
            ]
          },
          {
            "start_seconds": 645,
            "end_seconds": 695,
            "voiceover_text": "A small girl drops flat onto the bricks, laughing so hard she cannot stand up. For a moment nothing here hurts anybody.",
            "keywords": [
              "laughing",
              "warmth",
              "kusuri"
            ]
          },
          {
            "start_seconds": 717,
            "end_seconds": 763,
            "voiceover_text": "Hakari gathers her in close and looks out across the hills. The smile stays put, but her eyes have already gone somewhere else.",
            "keywords": [
              "hakari",
              "embrace",
              "distant look"
            ]
          }
        ]
      },
      {
