{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clipforge-telegram-bot",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "CLIPFORGE_BOT_KV",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ]
}
