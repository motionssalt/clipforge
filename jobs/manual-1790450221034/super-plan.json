        "segments": [
          {
            "start_seconds": 1260,
            "end_seconds": 1294,
            "voiceover_text": "Rentaro says it plainly under the lamp. Everyone here loves Hakari, so everyone here goes tonight and brings her out of that house.",
            "keywords": [
