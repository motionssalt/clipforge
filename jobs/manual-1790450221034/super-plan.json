        "segments": [
          {
            "start_seconds": 1022,
            "end_seconds": 1042,
            "voiceover_text": "Hakari turns from the window and says she is going home now. The refusal reaches her before she even gets near the door.",
            "keywords": [
              "hakari",
              "refusal",
              "window"
            ]
          },
          {
            "start_seconds": 1042,
            "end_seconds": 1071,
            "voiceover_text": "Now she is begging out loud, held back by hands she cannot shake off, while a voice lists everything she is supposedly worth.",
            "keywords": [
              "begging",
              "held back",
              "confrontation"
            ]
          },
          {
            "start_seconds": 1071,
            "end_seconds": 1105,
            "voiceover_text": "Her mother stays seated through all of it, unhurried, one finger resting at her lip. She never raises her voice. She never needs to.",
            "keywords": [
              "mother",
              "seated",
              "calm"
            ]
          },
          {
            "start_seconds": 1105,
            "end_seconds": 1141,
            "voiceover_text": "Then she pulls Hakari's head against her chest and shuts her eyes. Hakari stays inside this house until high school is over.",
            "keywords": [
              "embrace",
              "confinement",
              "verdict"
            ]
          }
        ]
      },
