        "segments": [
          {
            "start_seconds": 777,
            "end_seconds": 822,
            "voiceover_text": "She pictures a veil, falling petals, and a white suit standing beside her on a hilltop. The daydream is finished down to the guests.",
            "keywords": [
              "wedding",
              "daydream",
              "petals"
            ]
          },
          {
            "start_seconds": 827,
            "end_seconds": 885,
            "voiceover_text": "Reality is a hushed mansion instead. Rentaro shrugs on a jacket, walks an empty hallway, and a woman in black is already waiting.",
            "keywords": [
              "mansion",
              "hallway",
              "waiting"
            ]
          },
          {
            "start_seconds": 889,
            "end_seconds": 942,
            "voiceover_text": "He ends up outside tall iron gates, waving up from the pavement. Inside the glass, Hakari presses one finger to her lips.",
            "keywords": [
              "gate",
              "waving",
              "secret"
            ]
          },
          {
            "start_seconds": 956,
            "end_seconds": 1021,
            "voiceover_text": "They talk through the bars on their phones. Then a hand closes around her shoulder from behind, and her voice stops mid-sentence.",
            "keywords": [
              "phone call",
              "shoulder",
              "interrupted"
            ]
          }
        ]
      },
      {
