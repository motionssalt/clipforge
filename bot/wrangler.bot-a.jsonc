{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clipforge-bot-a",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "vars": {
    "ORIGINAL_CLIPFORGE_REPOSITORY": "motionssalt/clipforge",
    "INTERNAL_RELAY_GROUP_CHAT_ID": "-5405387856",
    "BOT_B_TELEGRAM_USERNAME": "Clipforgedl_bot"
  },
  "kv_namespaces": [
    {
      "binding": "CLIPFORGE_BOT_KV",
      "id": "b09957b233c247deb40cc703ffadc95d"
    }
  ],
  // bug-51: the cron trigger drives the Shadow Clone job sweep
  // (scheduled() in src/index.js) — the webhook stages long-running clone
  // creations in KV and this once-a-minute tick resumes/finalizes/fails them,
  // guaranteeing every attempt ends in a user-visible success or error
  // message instead of the killed-request silence at "Preparing repository…".
  "triggers": {
    "crons": ["* * * * *"]
  }
  // bug-62: no trailing comma above — nothing follows this object before the
  // closing brace, and while JSONC/JSON5 tolerate trailing commas, the
  // scripts/reclaim-stale-task-labels.mjs parser stripping comments to
  // whitespace and then calling strict JSON.parse does not. The parser has
  // also been hardened, but keeping the source clean prevents a re-trip.
  // Secret bindings (set via `wrangler secret put`, never committed):
  //   TELEGRAM_BOT_TOKEN        — Bot A's Telegram bot token
  //   KV_ENCRYPTION_KEY         — base64 32-byte AES-256-GCM key for credential envelopes
  //   TELEGRAM_WEBHOOK_SECRET   — X-Telegram-Bot-Api-Secret-Token value (§13 invariant #3)
  //   RELAY_ENCRYPTION_KEY      — relay sealed-envelope key (§9.2; used when the relay phase lands)
}
